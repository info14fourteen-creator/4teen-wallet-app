{
  "expo": {
    "name": "4TEEN",
    "slug": "stan-at",
    "version": "1.0.6",
    "description": "4TEEN self-custody TRON wallet for creating, importing, and managing wallets with secure local signing.",
    "orientation": "default",
    "icon": "./assets/images/play-store-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow 4TEEN to use Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 4TEEN to access your camera to scan QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-router"
    ],
    "android": {
      "package": "me.fourteen.wallet",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/play-store-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "me.fourteen.wallet",
      "supportsTablet": true,
      "buildNumber": "16",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "4TEEN",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tg"
        ]
      }
    },
    "scheme": "fourteenwallet",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e59098ab-bd81-4c0f-97a3-f4c9022b1176"
      }
    },
    "owner": "ag-plus-llc"
  }
}
